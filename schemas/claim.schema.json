{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claim_id": {
      "pattern": "^KB-[0-9]{3}-C[0-9]{3,}$",
      "type": "string"
    },
    "claim_text": {
      "minLength": 1,
      "type": "string"
    },
    "derived_from": {
      "items": {
        "pattern": "^KB-[0-9]{3}-C[0-9]{3,}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "evidence_state": {
      "enum": [
        "documented",
        "observed",
        "validated",
        "derived",
        "proposed",
        "unverified",
        "insufficient_evidence"
      ]
    },
    "source_locators": {
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/source_locator_v1"},
          {"$ref": "#/$defs/source_locator_v2"}
        ]
      },
      "type": "array",
      "uniqueItems": true
    },
    "stage_id": {
      "pattern": "^KB-[0-9]{3}$",
      "type": "string"
    },
    "verification_status": {
      "enum": [
        "unreviewed",
        "machine_validated",
        "peer_reviewed",
        "verified_by_fixture",
        "rejected"
      ]
    }
  },
  "$defs": {
    "source_locator_v1": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "pattern": "^SRC-KB-[0-9]{3}-[0-9]{2}$",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "type": "string"
        },
        "locator_version": {
          "const": 1
        },
        "snapshot_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "locator",
        "locator_version",
        "snapshot_sha256"
      ],
      "type": "object"
    },
    "source_locator_v2": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "pattern": "^SRC-KB-[0-9]{3}-[0-9]{2}$",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "type": "string"
        },
        "locator_version": {
          "const": 2
        },
        "snapshot_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "normalized_document_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "locator_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "locator",
        "locator_version",
        "snapshot_sha256",
        "normalized_document_sha256",
        "locator_fingerprint"
      ],
      "type": "object"
    }
  },
  "required": [
    "claim_id",
    "stage_id",
    "claim_text",
    "evidence_state",
    "source_locators",
    "derived_from",
    "verification_status"
  ],
  "allOf": [
    {
      "if": {
        "required": ["evidence_state"],
        "properties": {"evidence_state": {"const": "derived"}}
      },
      "then": {
        "properties": {
          "derived_from": {"minItems": 1},
          "source_locators": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "required": ["evidence_state"],
        "properties": {"evidence_state": {"const": "documented"}}
      },
      "then": {
        "properties": {
          "source_locators": {"minItems": 1},
          "derived_from": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "required": ["evidence_state"],
        "properties": {"evidence_state": {"const": "observed"}}
      },
      "then": {
        "properties": {
          "source_locators": {"maxItems": 0},
          "derived_from": {"maxItems": 0}
        }
      }
    }
  ],
  "type": "object"
}
