{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/image-evidence-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["image_id", "stage_id", "source_id", "url", "retrieval_status", "inspection_status", "sha256", "claims_supported", "notes"],
  "properties": {
    "image_id": {"type": "string", "pattern": "^IMG-KB-[0-9]{3}-[0-9]{3}$"},
    "stage_id": {"type": "string", "pattern": "^KB-[0-9]{3}$"},
    "source_id": {"type": "string", "pattern": "^SRC-KB-[0-9]{3}-[0-9]{2}$"},
    "url": {"type": "string", "pattern": "^https://"},
    "retrieval_status": {"enum": ["discovered", "retrieved", "cache_miss", "failed"]},
    "inspection_status": {"enum": ["not_inspected", "inspected"]},
    "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "claims_supported": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^KB-[0-9]{3}-C[0-9]{3,}$"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"inspection_status": {"const": "inspected"}}},
      "then": {"properties": {"retrieval_status": {"const": "retrieved"}, "sha256": {"type": "string"}, "claims_supported": {"minItems": 1}}}
    }
  ]
}
