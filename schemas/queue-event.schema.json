{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/queue-event.schema.json",
  "title": "EDIS Rolling Queue Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "queue_id",
    "queue_revision",
    "controller_run_id",
    "event_type",
    "recorded_at",
    "task_id",
    "details"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "pattern": "^RQEVT-[A-Za-z0-9-]+$"},
    "queue_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "queue_revision": {"type": "integer", "minimum": 0},
    "controller_run_id": {"type": ["string", "null"], "pattern": "^RQRUN-[A-Za-z0-9-]+$"},
    "event_type": {
      "enum": [
        "queue_initialized",
        "task_leased",
        "task_transitioned",
        "task_blocked",
        "task_completed",
        "task_superseded",
        "queue_refreshed",
        "lease_released",
        "drift_detected",
        "dry_run_planned"
      ]
    },
    "recorded_at": {"type": "string", "format": "date-time"},
    "task_id": {"type": ["string", "null"], "pattern": "^RQ-[0-9]{4,}$"},
    "details": {"type": "object"}
  }
}
