{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "aliases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {"pattern": "^SRC-KB-[0-9]{3}-[0-9]{2}$", "type": "string"},
          "legacy_urls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"pattern": "^https://", "type": "string"}},
          "canonical_url": {"pattern": "^https://", "type": "string"},
          "verification_state": {"const": "verified_official_current_page"}
        },
        "required": ["source_id", "legacy_urls", "canonical_url", "verification_state"]
      }
    }
  },
  "required": ["schema_version", "aliases"],
  "type": "object"
}
