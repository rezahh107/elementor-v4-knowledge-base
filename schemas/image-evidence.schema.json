{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claims_supported": {
      "items": {
        "pattern": "^KB-[0-9]{3}-C[0-9]{3,}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "image_id": {
      "pattern": "^IMG-KB-[0-9]{3}-[0-9]{3}$",
      "type": "string"
    },
    "inspection_status": {
      "enum": ["not_inspected", "inspected"]
    },
    "notes": {
      "items": {"type": "string"},
      "type": "array"
    },
    "retrieval_status": {
      "enum": ["discovered", "retrieved", "cache_miss", "failed"]
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": ["string", "null"]
    },
    "snapshot_format_version": {
      "const": 1
    },
    "snapshot_path": {
      "pattern": "^evidence/snapshots/SRC-KB-[0-9]{3}-[0-9]{2}/images/IMG-KB-[0-9]{3}-[0-9]{3}-[a-f0-9]{64}\\.(png|jpg|jpeg|gif|webp|svg)$",
      "type": "string"
    },
    "content_type": {
      "enum": ["image/png", "image/jpeg", "image/gif", "image/webp", "image/svg+xml"]
    },
    "content_length": {
      "minimum": 1,
      "maximum": 16777216,
      "type": "integer"
    },
    "source_id": {
      "pattern": "^SRC-KB-[0-9]{3}-[0-9]{2}$",
      "type": "string"
    },
    "stage_id": {
      "pattern": "^KB-[0-9]{3}$",
      "type": "string"
    },
    "url": {
      "pattern": "^https://",
      "type": "string"
    }
  },
  "required": [
    "image_id",
    "stage_id",
    "source_id",
    "url",
    "retrieval_status",
    "inspection_status",
    "sha256",
    "claims_supported",
    "notes"
  ],
  "allOf": [
    {
      "if": {
        "required": ["snapshot_format_version"]
      },
      "then": {
        "properties": {
          "retrieval_status": {"const": "retrieved"},
          "sha256": {"pattern": "^[a-f0-9]{64}$", "type": "string"}
        },
        "required": ["snapshot_path", "content_type", "content_length"]
      }
    }
  ],
  "type": "object"
}
